# Copie para .env e ajuste: cp .env.example .env
# O .env real NÃO é versionado (.gitignore).

# Banco de dados (usados pelo serviço db e pela API)
DB_USER=reservas
DB_PASSWORD=troque-esta-senha
DB_NAME=reservas

# Porta da API publicada no host (a 3000 pode estar ocupada por outra aplicação)
API_PORT=3000
